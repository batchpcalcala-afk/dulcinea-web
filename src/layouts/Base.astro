---
import '../styles/global.css';
const {
  title = 'El Viaje de Dulcinea del Toboso — El viaje que nunca termina',
  description = 'La auténtica Dulcinea de 1616 viaja de El Toboso a Alcalá de Henares en busca de Cervantes. Sigue su camino, descubre cada villa y a los escuderos que la ayudan.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <!-- Etiqueta de Google (Google Ads AW-347505670) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-347505670"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'AW-347505670');
    gtag('event', 'conversion', {'send_to': 'AW-347505670/XiEyCN3ekpQdEIaI2qUB'});
  </script>

  <!-- Conversión: clic en cualquier botón de WhatsApp -->
  <script is:inline>
    document.addEventListener('click', function (e) {
      var a = e.target.closest('a[href*="wa.me"], a[href*="whatsapp"]');
      if (!a) return;
      gtag('event', 'conversion', {
        'send_to': 'AW-347505670/rT-aCIDX27YdEIaI2qUB',
        'value': 1.0,
        'currency': 'EUR'
      });
    });
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=IM+Fell+English+SC&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
</body>
</html>
