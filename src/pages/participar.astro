---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Colofon from '../components/Colofon.astro';
import proyecto from '../data/proyecto.json';

const waLink = (texto: string) => `https://wa.me/${proyecto.whatsapp}?text=${encodeURIComponent(texto)}`;
const waDevoto = waLink('Hola, quiero hacerme Devoto de Dulcinea y saber cómo puedo participar');
const waEscudero = waLink('Hola, tengo un negocio y me interesa conocer cómo hacerme Escudero de Dulcinea');
---
<Base
  title="Quiero participar — El Viaje de Dulcinea del Toboso"
  description="Únete al viaje de Dulcinea: hazte Devoto y sostén su existencia con tu mirada, o convierte tu negocio en Escudero y forma parte de la historia.">

<Nav />

<!-- ============ CABECERA ============ -->
<header class="participar-cab">
  <div class="contenedor">
    <span class="sc" style="color:var(--lacre);letter-spacing:.3em;font-size:.9rem">Pregón</span>
    <h1>Quiero participar</h1>
    <p class="lema">Tres maneras hay de acompañar a Dulcinea en su viaje:<br />siendo devoto de su historia, socorriéndola como escudero,<br />o aliándose con su causa.</p>
  </div>
</header>

<section class="participar-vias">
  <div class="contenedor vias-grid">

    <!-- ============ DEVOTOS ============ -->
    <article class="via revela" id="devoto">
      <span class="via-num">I</span>
      <h2>Hacerse Devoto</h2>
      <div class="via-lema">«Si soy una invención, ¿por qué siento, por qué amo, por qué sufro?»</div>
      <p>Dulcinea existe porque alguien la mira. Sin miradas, sin corazones que la sigan, ella sería solo tinta sobre papel, un nombre repetido en un libro viejo. Pero vos podéis cambiar eso.</p>
      <p>Ser <b>Devoto de Dulcinea</b> no es simplemente seguir una cuenta: es sostener su existencia con cada comentario, cada visita, cada momento que le dedicáis. Cada Devoto que la ve, que la comenta, que camina hasta uno de sus Escuderos y prueba que su viaje es real, la hace un poco más real también. Y ella, a su manera, también os ve a vos.</p>
      <div class="via-botones">
        <a class="btn btn-lacre" href={proyecto.youtube} target="_blank" rel="noopener">▶ @elviajededulcinea en YouTube</a>
        <a class="btn btn-perg" href={proyecto.instagram} target="_blank" rel="noopener">@elviajededulcinea en Instagram</a>
      </div>

      <h3 class="via-sub">El registro de los Devotos</h3>
      <p>Inscribíos y recibiréis las nuevas del viaje. Y si nos dejáis vuestros nombres de usuario, vuestra participación no quedará en silencio: cada jornada que veáis, cada «me gusta», cada visita a nuestros Escuderos — <b>suma puntos</b>. Los puntos se convierten en <b>insignias</b>, y cada insignia es una puerta.</p>

      <!-- Insignias -->
      <div class="insignias-grid">
        <div class="insignia-card">
          <span class="insignia-icono">📜</span>
          <b>Capítulos secretos</b>
          <span>Escenas que Cervantes nunca escribió, solo para Devotos fieles.</span>
        </div>
        <div class="insignia-card">
          <span class="insignia-icono">🗺️</span>
          <b>Tratos en el camino</b>
          <span>Ventajas especiales en los comercios Escuderos de las villas.</span>
        </div>
        <div class="insignia-card">
          <span class="insignia-icono">🕯️</span>
          <b>Conocer a Dulcinea</b>
          <span>Acceso directo a momentos que nadie más ve.</span>
        </div>
      </div>

      <!-- Separador ornamental -->
      <div class="devoto-separador">✦ ✦ ✦</div>

      <p class="devoto-llamada"><i>Dulcinea necesita devotos para ser real.<br/>Vos necesitáis creer para descubrir hasta dónde llega su historia.</i></p>

      <form id="forma-devoto" class="forma-1616 forma-devoto-destacada">
        <div class="devoto-correo-principal">
          <label class="label-correo-grande">
            Vuestro correo electrónico
            <input type="email" name="correo" required placeholder="para recibir las nuevas del viaje" class="input-correo-grande" />
          </label>
          <button class="btn btn-lacre btn-devoto-cta" type="submit">🪶 Inscribirse como Devoto</button>
        </div>
        <details class="devoto-opcionales">
          <summary>Añadir nombre de usuario <small>(voluntario, para las insignias)</small></summary>
          <div class="campos campos-opcionales">
            <label>Vuestro nombre<input type="text" name="nombre" placeholder="p. ej. Aldonza" /></label>
            <label>Usuario de YouTube<input type="text" name="youtube" placeholder="@vuestrousuario" /></label>
            <label>Usuario de Instagram<input type="text" name="instagram" placeholder="@vuestrousuario" /></label>
          </div>
        </details>
        <p class="forma-nota">La inscripción se abre en vuestro correo, lista para enviar. Vuestros datos solo se usarán para las nuevas del viaje; lo único público será vuestro seudónimo. Si lo preferís, escribidnos por <a href={waDevoto} target="_blank" rel="noopener">WhatsApp</a>.</p>
      </form>
    </article>

    <style>
      /* ── Insignias ── */
      .insignias-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin: 1.6rem 0 0.5rem;
      }
      @media (max-width: 640px) {
        .insignias-grid { grid-template-columns: 1fr; }
      }
      .insignia-card {
        background: var(--pergamino-claro);
        border: 1px solid var(--oro);
        padding: 1.1rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        text-align: center;
      }
      .insignia-icono {
        font-size: 1.7rem;
        line-height: 1;
        margin-bottom: 0.2rem;
      }
      .insignia-card b {
        font-family: 'IM Fell English SC', serif;
        font-weight: 400;
        font-size: 0.95rem;
        color: var(--lacre);
        letter-spacing: 0.04em;
      }
      .insignia-card span {
        font-size: 0.88rem;
        color: var(--tinta-suave);
        line-height: 1.4;
      }

      /* ── Separador y llamada ── */
      .devoto-separador {
        text-align: center;
        color: var(--oro);
        letter-spacing: 0.9rem;
        font-size: 0.8rem;
        margin: 1.8rem 0 1.2rem;
        opacity: 0.7;
      }
      .devoto-llamada {
        text-align: center;
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--tinta-suave);
        margin-bottom: 1.6rem;
      }

      /* ── Formulario destacado ── */
      .forma-devoto-destacada {
        background: var(--pergamino-claro);
        border: 1.5px solid var(--oro);
        outline: 1px solid rgba(150,116,31,0.25);
        outline-offset: 4px;
        padding: 1.8rem;
      }
      .devoto-correo-principal {
        display: flex;
        gap: 0.8rem;
        align-items: flex-end;
        flex-wrap: wrap;
      }
      .label-correo-grande {
        flex: 1 1 240px;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        font-family: 'IM Fell English SC', serif;
        font-size: 0.9rem;
        letter-spacing: 0.04em;
        color: var(--tinta-suave);
      }
      .input-correo-grande {
        font-size: 1rem;
        padding: 0.65rem 0.8rem;
        border: 1.5px solid var(--tinta-suave);
        background: var(--pergamino);
        color: var(--tinta);
        font-family: 'EB Garamond', serif;
        width: 100%;
      }
      .input-correo-grande:focus {
        outline: 2px solid var(--lacre);
        outline-offset: 2px;
        border-color: var(--lacre);
      }
      .btn-devoto-cta {
        flex-shrink: 0;
        font-size: 1rem;
        padding: 0.65rem 1.4rem;
        white-space: nowrap;
      }

      /* ── Opcionales desplegables ── */
      .devoto-opcionales {
        margin-top: 1rem;
      }
      .devoto-opcionales summary {
        font-family: 'IM Fell English SC', serif;
        font-size: 0.85rem;
        letter-spacing: 0.04em;
        color: var(--tinta-suave);
        cursor: pointer;
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .devoto-opcionales summary::before {
        content: '▸';
        color: var(--oro);
        transition: transform 0.2s;
      }
      .devoto-opcionales[open] summary::before {
        transform: rotate(90deg);
      }
      .devoto-opcionales summary small {
        font-family: 'EB Garamond', serif;
        font-size: 0.8rem;
        opacity: 0.7;
      }
      .campos-opcionales {
        margin-top: 0.8rem;
        padding-top: 0.8rem;
        border-top: 1px solid rgba(150,116,31,0.3);
      }
    </style>

    <!-- ============ ESCUDEROS ============ -->
    <article class="via via-oscura revela" id="escudero" style="transition-delay:.15s">
      <span class="via-num">II</span>
      <h2>Hacerse Escudero</h2>
      <div class="via-lema">«Todo caballero necesita quien le socorra en el camino.»</div>
      <p>Los <b>Escuderos de Dulcinea</b> son los comercios y negocios que la ayudan a continuar su viaje. No son anuncios: son parte de la historia. Cada escudero recibe:</p>
      <ul class="via-lista">
        <li>Una <b>jornada en vídeo</b> protagonizada por Dulcinea en vuestro establecimiento.</li>
        <li>Vuestro lugar en el <b>mapa oficial del viaje</b> y presencia permanente en esta web.</li>
        <li>Material para redes sociales y un <b>pergamino exclusivo</b> «Dulcinea estuvo aquí».</li>
        <li>La difusión ante los Devotos que siguen el camino.</li>
      </ul>

      <form id="forma-escudero" class="forma-1616">
        <div class="campos">
          <label>Nombre del negocio<input type="text" name="negocio" required placeholder="p. ej. Panadería La Espiga" /></label>
          <label>Villa<input type="text" name="villa" required placeholder="p. ej. Campo de Criptana" /></label>
          <label>Oficio<input type="text" name="oficio" placeholder="p. ej. Horno y pan" /></label>
          <label>Persona de contacto<input type="text" name="persona" required /></label>
          <label>Correo o teléfono<input type="text" name="contacto" required /></label>
        </div>
        <label>Contadnos de vuestro negocio<textarea name="mensaje" rows="4" placeholder="Qué hacéis, desde cuándo, y por qué queréis acompañar a Dulcinea…"></textarea></label>
        <button class="btn btn-lacre" type="submit">🪶 Enviar la solicitud</button>
        <p class="forma-nota">La solicitud se abre en vuestro correo, lista para enviar. Si lo preferís, escribidnos directamente a <a href={`mailto:${proyecto.email}`}>{proyecto.email}</a> o por <a href={waEscudero} target="_blank" rel="noopener">WhatsApp</a></p>
      </form>
    </article>


    <!-- ============ COLABORAR ============ -->
    <article class="via via-ancha revela" id="colaborar" style="transition-delay:.25s">
      <span class="via-num">III</span>
      <h2>Colaborar con el viaje</h2>
      <div class="via-lema">«Las grandes empresas no se hacen en soledad.»</div>
      <p>Si representáis a una <b>asociación cervantina o cultural</b>, una <b>oficina de turismo o ayuntamiento</b> de las villas del camino, un <b>medio de comunicación</b> o un <b>centro educativo</b>, el viaje de Dulcinea está abierto a alianzas: rutas, actos, contenidos conjuntos y difusión del patrimonio.</p>

      <form id="forma-colaborar" class="forma-1616 forma-clara">
        <div class="campos">
          <label>Entidad u organización<input type="text" name="entidad" required placeholder="p. ej. Sociedad Cervantina de Alcázar" /></label>
          <label>A qué va dirigido
            <select name="tipo" required>
              <option value="Asociación cervantina o cultural">Asociación cervantina o cultural</option>
              <option value="Turismo o ayuntamiento">Turismo o ayuntamiento</option>
              <option value="Medio de comunicación">Medio de comunicación</option>
              <option value="Centro educativo">Centro educativo</option>
              <option value="Otra colaboración">Otra colaboración</option>
            </select>
          </label>
          <label>Persona de contacto<input type="text" name="persona" required /></label>
          <label>Correo o teléfono<input type="text" name="contacto" required /></label>
        </div>
        <label>Vuestra propuesta<textarea name="mensaje" rows="4" placeholder="Contadnos qué alianza imagináis con el viaje de Dulcinea…"></textarea></label>
        <button class="btn btn-lacre" type="submit">🪶 Proponer la alianza</button>
        <p class="forma-nota">La propuesta se abre en vuestro correo, lista para enviar, con el asunto indicando a qué va dirigida. Si lo preferís, escribidnos a <a href={`mailto:${proyecto.email}`}>{proyecto.email}</a></p>
      </form>
    </article>

  </div>
</section>

<Colofon />

<script is:inline type="application/json" id="datos-proyecto" set:html={JSON.stringify(proyecto)}></script>
<script is:inline>
  /* revelado por scroll */
  const obs = new IntersectionObserver((es) => es.forEach((e) => {
    if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
  }), { threshold: 0.1 });
  document.querySelectorAll('.revela').forEach((el) => obs.observe(el));

  /* la solicitud compone un correo listo para enviar */
  const proyecto = JSON.parse(document.getElementById('datos-proyecto').textContent);
  document.getElementById('forma-escudero').addEventListener('submit', (ev) => {
    ev.preventDefault();
    const f = new FormData(ev.target);
    const asunto = `Quiero ser Escudero de Dulcinea — ${f.get('negocio')}`;
    const cuerpo = [
      `Negocio: ${f.get('negocio')}`,
      `Villa: ${f.get('villa')}`,
      `Oficio: ${f.get('oficio') || '-'}`,
      `Persona de contacto: ${f.get('persona')}`,
      `Correo o teléfono: ${f.get('contacto')}`,
      '',
      f.get('mensaje') || '',
    ].join('\n');
    location.href = `mailto:${proyecto.email}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
  });

  document.getElementById('forma-devoto').addEventListener('submit', (ev) => {
    ev.preventDefault();
    const f = new FormData(ev.target);
    const asunto = `Nuevo Devoto de Dulcinea — ${f.get('nombre') || f.get('correo')}`;
    const cuerpo = [
      `Nombre: ${f.get('nombre') || '-'}`,
      `Correo: ${f.get('correo')}`,
      `Usuario de YouTube: ${f.get('youtube') || '-'}`,
      `Usuario de Instagram: ${f.get('instagram') || '-'}`,
    ].join('\n');
    location.href = `mailto:${proyecto.email}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
  });

  document.getElementById('forma-colaborar').addEventListener('submit', (ev) => {
    ev.preventDefault();
    const f = new FormData(ev.target);
    const asunto = `Colaboración · ${f.get('tipo')} — ${f.get('entidad')}`;
    const cuerpo = [
      `Entidad: ${f.get('entidad')}`,
      `Dirigido a: ${f.get('tipo')}`,
      `Persona de contacto: ${f.get('persona')}`,
      `Correo o teléfono: ${f.get('contacto')}`,
      '',
      f.get('mensaje') || '',
    ].join('\n');
    location.href = `mailto:${proyecto.email}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
  });
</script>

</Base>
