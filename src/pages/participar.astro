---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Colofon from '../components/Colofon.astro';
import proyecto from '../data/proyecto.json';

const waLink = (texto: string) => `https://wa.me/${proyecto.whatsapp}?text=${encodeURIComponent(texto)}`;
const waDevoto = waLink('Hola, quiero hacerme Devoto de Dulcinea y saber cómo puedo participar');
const waEscudero = waLink('Hola, tengo un negocio y me interesa conocer cómo hacerme Escudero de Dulcinea');
const waColaborar = waLink('Hola, represento a una entidad y me interesa colaborar con El Viaje de Dulcinea');
---
<Base
  title="Quiero participar — El Viaje de Dulcinea del Toboso"
  description="Únete al viaje de Dulcinea: hazte Devoto y sostén su existencia con tu mirada, o convierte tu negocio en Escudero y forma parte de la historia.">

<Nav />

<!-- ============ HERO CON TARJETAS ============ -->
<header class="part-hero">
  <div class="contenedor">
    <p class="part-eyebrow sc">El Viaje de Dulcinea · Participa</p>
    <h1 class="part-h1">Elige cómo acompañar<br/>a Dulcinea</h1>
    <p class="part-sub">Forma parte de la comunidad, incorpora tu negocio a la ruta<br/>o propón una colaboración cultural.</p>
  </div>

  <!-- Tarjetas de selección -->
  <div class="contenedor part-cards-wrap">
    <div class="part-cards">

      <a class="part-card revela" href="#devoto">
        <div class="part-card-img part-card-img-devoto">
          <svg viewBox="0 0 80 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="10" y="8" width="44" height="34" rx="3" fill="#c9a0a8" opacity=".4"/>
            <rect x="14" y="12" width="44" height="34" rx="3" fill="#b06070" opacity=".5"/>
            <line x1="36" y1="12" x2="29" y2="29" stroke="#7E241B" stroke-width="1.5"/>
            <line x1="36" y1="12" x2="43" y2="29" stroke="#7E241B" stroke-width="1.5"/>
            <circle cx="36" cy="30" r="4" fill="#7E241B" opacity=".8"/>
            <line x1="20" y1="34" x2="52" y2="34" stroke="#7E241B" stroke-width="1" opacity=".4"/>
            <text x="22" y="42" font-size="8" fill="#7E241B" opacity=".5" font-family="serif">✦ ✦ ✦</text>
          </svg>
        </div>
        <p class="part-card-label sc">I · Para quienes siguen<br/>la historia</p>
        <h2 class="part-card-h">Hacerse Devoto</h2>
        <p class="part-card-desc">Entra en la comunidad que acompaña a Dulcinea y recibe su Carta de Acogida.</p>
        <span class="part-card-cta">Quiero ser Devoto ↓</span>
      </a>

      <a class="part-card revela" href="#escudero" style="transition-delay:.1s">
        <div class="part-card-img part-card-img-escudero">
          <svg viewBox="0 0 80 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="22" y="20" width="36" height="28" fill="#8fa88a" opacity=".4"/>
            <rect x="26" y="16" width="28" height="8" fill="#8fa88a" opacity=".5"/>
            <rect x="30" y="32" width="8" height="16" fill="#5a7a55" opacity=".6"/>
            <rect x="42" y="34" width="10" height="10" fill="#5a7a55" opacity=".5"/>
            <line x1="22" y1="20" x2="58" y2="20" stroke="#5a7a55" stroke-width="1.5"/>
            <line x1="14" y1="20" x2="22" y2="12" stroke="#5a7a55" stroke-width="1.5"/>
            <line x1="66" y1="20" x2="58" y2="12" stroke="#5a7a55" stroke-width="1.5"/>
          </svg>
        </div>
        <p class="part-card-label sc">II · Para comercios y<br/>negocios</p>
        <h2 class="part-card-h">Hacerse Escudero</h2>
        <p class="part-card-desc">Cuéntanos la historia de tu establecimiento y descubre cómo puede formar parte del camino.</p>
        <span class="part-card-cta part-card-cta-verde">Quiero ser Escudero ↓</span>
      </a>

      <a class="part-card revela" href="#colaborar" style="transition-delay:.2s">
        <div class="part-card-img part-card-img-colaborar">
          <svg viewBox="0 0 80 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="12" y="14" width="38" height="28" rx="1" fill="#7a9ab0" opacity=".3"/>
            <line x1="20" y1="22" x2="42" y2="22" stroke="#2B4A6A" stroke-width="1" opacity=".5"/>
            <line x1="20" y1="27" x2="38" y2="27" stroke="#2B4A6A" stroke-width="1" opacity=".4"/>
            <line x1="20" y1="32" x2="34" y2="32" stroke="#2B4A6A" stroke-width="1" opacity=".3"/>
            <circle cx="52" cy="20" r="8" fill="#7a9ab0" opacity=".4" stroke="#2B4A6A" stroke-width="1"/>
            <line x1="48" y1="20" x2="56" y2="20" stroke="#2B4A6A" stroke-width="1.2"/>
            <line x1="52" y1="16" x2="52" y2="24" stroke="#2B4A6A" stroke-width="1.2"/>
            <path d="M44 36 Q52 28 60 32" stroke="#2B4A6A" stroke-width="1" fill="none" opacity=".5"/>
          </svg>
        </div>
        <p class="part-card-label sc">III · Para entidades y<br/>profesionales</p>
        <h2 class="part-card-h">Colaborar con el Viaje</h2>
        <p class="part-card-desc">Propón una actividad, comparte una investigación o ayúdanos a dar a conocer el patrimonio cervantino.</p>
        <span class="part-card-cta part-card-cta-azul">Proponer una colaboración ↓</span>
      </a>

    </div>
  </div>
</header>

<!-- ============ SECCIONES DETALLE ============ -->
<main class="part-secciones">

  <!-- ── I DEVOTOS ── -->
  <section class="part-sec revela" id="devoto">
    <div class="contenedor part-sec-inner">

      <div class="part-sec-texto">
        <p class="part-sec-label sc">I · Comunidad</p>
        <h2 class="part-sec-h">Hacerse Devoto</h2>
        <blockquote class="part-cita">«Un seguidor observa el camino;<br/>un Devoto decide recorrerlo contigo.»</blockquote>
        <p>Si sigues mis pasos, me hará ilusión saber quién camina conmigo.</p>
        <ul class="part-pasos">
          <li>Indica tu nombre, correo y usuario de Instagram o YouTube.</li>
          <li>Envía la solicitud desde tu correo.</li>
          <li>Cuando se confirme tu incorporación, recibirás la Carta de Acogida en PDF.</li>
        </ul>
        <div class="part-sec-links">
          <a href={proyecto.youtube} target="_blank" rel="noopener" class="part-enlace">▶ YouTube</a>
          <a href={proyecto.instagram} target="_blank" rel="noopener" class="part-enlace">Instagram</a>
        </div>
      </div>

      <div class="part-sec-forma">
        <div class="forma-tarjeta">
          <h3 class="forma-tarjeta-h">Solicita tu incorporación</h3>
          <form id="forma-devoto" autocomplete="off">
            <div class="ft-campos">
              <label class="ft-label">Nombre<input type="text" name="nombre" placeholder="p. ej. Aldonza" /></label>
              <label class="ft-label">Correo electrónico<input type="email" name="correo" required placeholder="tu@correo.es" /></label>
              <label class="ft-label">Ciudad o país<input type="text" name="ciudad" placeholder="p. ej. Alcalá de Henares" /></label>
              <label class="ft-label">Red social
                <select name="red">
                  <option value="">Selecciona una</option>
                  <option value="Instagram">Instagram</option>
                  <option value="YouTube">YouTube</option>
                  <option value="Ambas">Ambas</option>
                  <option value="Ninguna">Ninguna</option>
                </select>
              </label>
              <label class="ft-label">Usuario<input type="text" name="usuario" placeholder="@tuusuario" /></label>
            </div>
            <label class="ft-rgpd">
              <input type="checkbox" name="rgpd" required />
              <span>He leído y acepto el tratamiento de mis datos para gestionar mi participación en el Viaje de Dulcinea. No se cederán a terceros.</span>
            </label>
            <button class="ft-btn ft-btn-lacre" type="submit" id="btn-devoto">Enviar solicitud</button>
            <p class="ft-nota" id="devoto-estado"></p>
            <a href={waDevoto} class="ft-wa" target="_blank" rel="noopener">También puedes consultar por WhatsApp.</a>
          </form>
        </div>
      </div>

    </div>
  </section>

  <!-- ── ACCESO DEVOTOS ── -->
  <section class="acc-devoto-banner revela">
    <div class="contenedor acc-devoto-inner">
      <div class="acc-devoto-texto">
        <p class="acc-devoto-eyebrow sc">Donde Habita la Historia</p>
        <h2 class="acc-devoto-h">¿Ya eres Devoto?</h2>
        <p class="acc-devoto-p">Tu espacio reservado te espera. Dossiers de investigación, hallazgos históricos y los documentos que acompañan cada vídeo del Viaje.</p>
      </div>
      <a href="/devotos/acceso" class="acc-devoto-cta">
        <span class="acc-devoto-cta-txt">Entrar en la Biblioteca</span>
        <span class="acc-devoto-cta-flecha">→</span>
      </a>
    </div>
  </section>

  <div class="part-sep"><span class="sc" style="letter-spacing:.3em;font-size:.75rem;color:var(--oro);opacity:.6">✦</span></div>

  <!-- ── II ESCUDEROS ── -->
  <section class="part-sec revela" id="escudero" style="transition-delay:.1s">
    <div class="contenedor part-sec-inner">

      <div class="part-sec-texto">
        <p class="part-sec-label sc part-sec-label-verde">II · Negocios del camino</p>
        <h2 class="part-sec-h">Hacerse Escudero</h2>
        <p>Tu negocio puede convertirse en una parada del Viaje. Queremos conocer el lugar, a las personas que le dan vida y la historia que merece ser contada.</p>
        <ul class="part-pasos part-pasos-verde">
          <li>Un vídeo que cuente la historia de tu establecimiento.</li>
          <li>Presencia en la web y en la ruta del Viaje.</li>
          <li>Materiales para compartir el paso de Dulcinea por tu negocio.</li>
        </ul>
        <a href={`/escuderos`} class="part-enlace-dest">Conoce a los Escuderos del Viaje</a>
      </div>

      <div class="part-sec-forma">
        <div class="forma-tarjeta">
          <h3 class="forma-tarjeta-h">Cuéntanos sobre tu negocio</h3>
          <form id="forma-escudero" autocomplete="off">
            <div class="ft-campos">
              <label class="ft-label">Nombre del negocio<input type="text" name="negocio" required placeholder="p. ej. Panadería La Espiga" /></label>
              <label class="ft-label">Localidad<input type="text" name="villa" required placeholder="p. ej. Campo de Criptana" /></label>
              <label class="ft-label">Persona de contacto<input type="text" name="persona" required /></label>
              <label class="ft-label">Correo electrónico<input type="email" name="contacto" required placeholder="tu@correo.es" /></label>
            </div>
            <label class="ft-label ft-label-full">¿Qué hace especial a tu negocio?<textarea name="mensaje" rows="3" placeholder="Qué hacéis, desde cuándo, por qué queréis acompañar a Dulcinea…"></textarea></label>
            <button class="ft-btn ft-btn-verde" type="submit">Abrir consulta en mi correo</button>
            <p class="ft-nota">Se abrirá un borrador. Envíalo para que podamos contactarte y hablar de las opciones.</p>
            <a href={waEscudero} class="ft-wa" target="_blank" rel="noopener">También puedes consultar por WhatsApp.</a>
          </form>
        </div>
      </div>

    </div>
  </section>

  <div class="part-sep"><span class="sc" style="letter-spacing:.3em;font-size:.75rem;color:var(--oro);opacity:.6">✦</span></div>

  <!-- ── III COLABORAR ── -->
  <section class="part-sec revela" id="colaborar" style="transition-delay:.2s">
    <div class="contenedor part-sec-inner">

      <div class="part-sec-texto">
        <p class="part-sec-label sc part-sec-label-azul">III · Cultura, turismo y patrimonio</p>
        <h2 class="part-sec-h">Colaborar con el Viaje</h2>
        <p>Si trabajas en turismo, cultura, educación o comunicación, o investigas la historia de alguno de los pueblos de la ruta, cuéntanos qué podríamos hacer juntos.</p>
        <ul class="part-pasos part-pasos-azul">
          <li>Organizar rutas, presentaciones o actividades culturales.</li>
          <li>Documentar lugares, tradiciones e historias poco conocidas.</li>
          <li>Crear contenidos para centros educativos, medios o entidades.</li>
        </ul>
      </div>

      <div class="part-sec-forma">
        <div class="forma-tarjeta">
          <h3 class="forma-tarjeta-h">Presenta tu propuesta</h3>
          <form id="forma-colaborar" autocomplete="off">
            <div class="ft-campos">
              <label class="ft-label">Nombre o entidad<input type="text" name="entidad" required placeholder="p. ej. Soc. Cervantina de Alcázar" /></label>
              <label class="ft-label">Ámbito
                <select name="tipo" required>
                  <option value="">Selecciona uno</option>
                  <option value="Asociación cervantina o cultural">Asociación cervantina o cultural</option>
                  <option value="Turismo o ayuntamiento">Turismo o ayuntamiento</option>
                  <option value="Medio de comunicación">Medio de comunicación</option>
                  <option value="Centro educativo">Centro educativo</option>
                  <option value="Otra colaboración">Otra colaboración</option>
                </select>
              </label>
              <label class="ft-label ft-label-full">Correo electrónico<input type="email" name="contacto" required placeholder="tu@correo.es" /></label>
            </div>
            <label class="ft-label ft-label-full">¿Qué te gustaría proponer?<textarea name="mensaje" rows="3" placeholder="Contadnos qué alianza imagináis con el viaje de Dulcinea…"></textarea></label>
            <button class="ft-btn ft-btn-azul" type="submit">Abrir propuesta en mi correo</button>
            <p class="ft-nota">Se abrirá un borrador. Envíalo para que podamos valorar la propuesta.</p>
            <a href={`mailto:${proyecto.email}`} class="ft-wa">Escribir directamente por correo.</a>
          </form>
        </div>
      </div>

    </div>
  </section>

</main>

<Colofon />

<script is:inline type="application/json" id="datos-proyecto" set:html={JSON.stringify(proyecto)}></script>
<script is:inline>
  /* revelado por scroll */
  const obs = new IntersectionObserver((es) => es.forEach((e) => {
    if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
  }), { threshold: 0.08 });
  document.querySelectorAll('.revela').forEach((el) => obs.observe(el));

  /* la solicitud compone un correo listo para enviar */
  const proyecto = JSON.parse(document.getElementById('datos-proyecto').textContent);

  /* ── Supabase: registro de Devotos ── */
  const SUPA_URL = 'https://mjdaeihmvlkhajmpxuet.supabase.co';
  const SUPA_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1qZGFlaWhtdmxraGFqbXB4dWV0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTUzNDA5MzcsImV4cCI6MjExMDkxNjkzN30.YUE8ZsPvyB5MXUy2UQOLEpNlUKr5XZubJYVmNuxKIHw';

  document.getElementById('forma-devoto').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const f = new FormData(ev.target);
    const btn = document.getElementById('btn-devoto');
    const estado = document.getElementById('devoto-estado');

    const datos = {
      nombre:  f.get('nombre') || null,
      correo:  f.get('correo'),
      ciudad:  f.get('ciudad') || null,
      red:     f.get('red') || null,
      usuario: f.get('usuario') || null,
    };

    btn.disabled = true;
    btn.textContent = 'Enviando…';
    estado.textContent = '';

    try {
      const res = await fetch(`${SUPA_URL}/rest/v1/devotos`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPA_KEY,
          'Authorization': `Bearer ${SUPA_KEY}`,
          'Prefer': 'return=minimal',
        },
        body: JSON.stringify(datos),
      });

      if (res.ok || res.status === 201) {
        btn.textContent = '¡Solicitud enviada!';
        estado.textContent = 'Gracias. Recibirás noticias pronto.';
        estado.style.color = 'var(--oro)';
        ev.target.reset();
      } else {
        throw new Error(`HTTP ${res.status}`);
      }
    } catch (err) {
      /* respaldo: abre mailto si Supabase falla */
      btn.disabled = false;
      btn.textContent = 'Enviar solicitud';
      estado.textContent = 'Hubo un problema. Enviando por correo…';
      const nombre = datos.nombre || datos.correo;
      const asunto = `Nuevo Devoto de Dulcinea — ${nombre}`;
      const cuerpo = [
        `Nombre: ${datos.nombre || '-'}`,
        `Correo: ${datos.correo}`,
        `Ciudad: ${datos.ciudad || '-'}`,
        `Red social: ${datos.red || '-'}`,
        `Usuario: ${datos.usuario || '-'}`,
      ].join('\n');
      setTimeout(() => {
        location.href = `mailto:${proyecto.email}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
      }, 800);
    }
  });

  document.getElementById('forma-escudero').addEventListener('submit', (ev) => {
    ev.preventDefault();
    const f = new FormData(ev.target);
    const asunto = `Quiero ser Escudero de Dulcinea — ${f.get('negocio')}`;
    const cuerpo = [
      `Negocio: ${f.get('negocio')}`,
      `Localidad: ${f.get('villa')}`,
      `Persona de contacto: ${f.get('persona')}`,
      `Correo: ${f.get('contacto')}`,
      '',
      f.get('mensaje') || '',
    ].join('\n');
    location.href = `mailto:${proyecto.email}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
  });

  document.getElementById('forma-colaborar').addEventListener('submit', (ev) => {
    ev.preventDefault();
    const f = new FormData(ev.target);
    const asunto = `Colaboración · ${f.get('tipo')} — ${f.get('entidad')}`;
    const cuerpo = [
      `Entidad: ${f.get('entidad')}`,
      `Ámbito: ${f.get('tipo')}`,
      `Correo: ${f.get('contacto')}`,
      '',
      f.get('mensaje') || '',
    ].join('\n');
    location.href = `mailto:${proyecto.email}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
  });
</script>

<style>
/* ══ HERO ══ */
.part-hero {
  background: var(--noche);
  color: var(--estrella);
  padding: 4rem 0 0;
  overflow: hidden;
}
.part-eyebrow {
  font-size: .8rem;
  letter-spacing: .25em;
  color: var(--lacre);
  margin-bottom: .8rem;
}
.part-h1 {
  font-family: 'IM Fell English', serif;
  font-size: clamp(2rem, 5vw, 3.2rem);
  font-weight: 400;
  line-height: 1.15;
  color: var(--estrella);
  margin-bottom: 1rem;
}
.part-sub {
  font-size: 1rem;
  color: var(--estrella);
  opacity: .75;
  line-height: 1.6;
  max-width: 50ch;
}

/* ── Tarjetas de selección ── */
.part-cards-wrap {
  margin-top: 2.5rem;
}
.part-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.2rem;
  align-items: start;
}
@media (max-width: 700px) {
  .part-cards { grid-template-columns: 1fr; }
}
.part-card {
  background: var(--pergamino-claro);
  color: var(--tinta);
  text-decoration: none;
  display: flex;
  flex-direction: column;
  padding: 1.4rem 1.3rem 1.6rem;
  border-top: 3px solid var(--lacre);
  transition: transform .2s, box-shadow .2s;
}
.part-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0,0,0,.18);
}
.part-card-img {
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  margin-bottom: 1rem;
}
.part-card-img-devoto  { background: #f0dde0; }
.part-card-img-escudero { background: #ddecd8; border-top-color: #4a7a44; }
.part-card-img-colaborar { background: #d8e6f0; border-top-color: #2B4A6A; }
.part-card-img svg { width: 70px; height: 52px; }
.part-card-label {
  font-size: .72rem;
  letter-spacing: .18em;
  color: var(--lacre);
  margin-bottom: .4rem;
  line-height: 1.4;
}
.part-card:nth-child(2) .part-card-label { color: #4a7a44; }
.part-card:nth-child(3) .part-card-label { color: #2B4A6A; }
.part-card-h {
  font-family: 'IM Fell English', serif;
  font-size: 1.35rem;
  font-weight: 400;
  margin-bottom: .5rem;
  color: var(--tinta);
}
.part-card-desc {
  font-size: .88rem;
  line-height: 1.5;
  color: var(--tinta-suave);
  flex: 1;
  margin-bottom: 1.2rem;
}
.part-card-cta {
  display: inline-block;
  background: var(--lacre);
  color: var(--estrella);
  font-family: 'IM Fell English SC', serif;
  font-size: .82rem;
  letter-spacing: .06em;
  padding: .55rem 1rem;
  text-align: center;
}
.part-card-cta-verde { background: #3a6435; }
.part-card-cta-azul  { background: #1e3a5a; }

/* ══ SECCIONES DETALLE ══ */
.part-secciones {
  background: var(--pergamino);
}
.part-sec {
  padding: 4rem 0;
}
.part-sec-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: start;
}
@media (max-width: 760px) {
  .part-sec-inner { grid-template-columns: 1fr; gap: 2rem; }
}
.part-sec-label {
  font-size: .75rem;
  letter-spacing: .2em;
  color: var(--lacre);
  margin-bottom: .5rem;
}
.part-sec-label-verde { color: #3a6435; }
.part-sec-label-azul  { color: #1e3a5a; }
.part-sec-h {
  font-family: 'IM Fell English', serif;
  font-size: 2rem;
  font-weight: 400;
  color: var(--tinta);
  margin-bottom: .9rem;
}
.part-cita {
  border-left: 3px solid var(--lacre);
  padding-left: .9rem;
  font-style: italic;
  color: var(--tinta-suave);
  margin: 1rem 0 1rem;
