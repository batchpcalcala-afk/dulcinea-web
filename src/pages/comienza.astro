---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Colofon from '../components/Colofon.astro';

const pilares = [
  { img: '/img/mosaico-serie.jpg', sub: 'La historia cobra vida', titulo: 'Serie cinematográfica', txt: 'Capítulos audiovisuales creados con lenguaje cinematográfico, voces y escenarios históricos. Cada jornada revela una nueva parte del misterio de Dulcinea.' },
  { img: '/img/mosaico-libro.jpg', sub: 'La historia se hace memoria', titulo: 'Libros', txt: 'Cada etapa del viaje se convertirá en un volumen que ampliará la aventura con historia, patrimonio y secretos que la pantalla no puede contar.' },
  { img: '/img/mosaico-rutas.jpg', sub: 'El espectador puede recorrerla', titulo: 'Rutas y destinos', txt: 'Los caminos de Dulcinea unen El Toboso con las ciudades vinculadas a Cervantes hasta Alcalá de Henares. El viaje puede descubrirse también con los propios pasos.' },
  { img: '/img/mosaico-turismo.jpg', sub: 'El pasado vuelve a hablar', titulo: 'Patrimonio e historia', txt: 'Monumentos, tradiciones, palabras y personajes reales forman parte de la narración. La ficción se convierte en una puerta para descubrir nuestra historia.' },
  { img: '/img/mosaico-devotos.jpg', sub: 'La comunidad que hace crecer el viaje', titulo: 'Devotos de Dulcinea', txt: 'Los Devotos siguen la historia, comentan, comparten, visitan los lugares y ayudan a que cada capítulo llegue más lejos. Sin ellos, Dulcinea seguiría siendo tinta sobre el papel.' },
  { img: '/img/mosaico-escuderos.jpg', sub: 'Quienes hacen posible el camino', titulo: 'Escuderos de Dulcinea', txt: 'Comercios, entidades y personas reales reciben a Dulcinea, forman parte de su historia y ayudan a sostener el proyecto. Cada Escudero deja una huella dentro del universo.' },
];

const chips = ['Podcasts','Experiencias','Insignias','Recompensas','Encuentros','Coleccionables','Contenido exclusivo','Y mucho más…'];

const villas = [
  { n:'El Toboso', estado:'actual', desc:'Dulcinea descubre la verdad y parte' },
  { n:'Campo de Criptana', estado:'futuro', desc:'Los molinos. Los gigantes.' },
  { n:'Mota del Cuervo', estado:'futuro', desc:'El balcón de La Mancha' },
  { n:'Alcázar de San Juan', estado:'futuro', desc:'Tradición cervantina' },
  { n:'Argamasilla de Alba', estado:'futuro', desc:'La Cueva de Medrano' },
  { n:'Puerto Lápice', estado:'futuro', desc:'La venta del Quijote' },
  { n:'Consuegra', estado:'futuro', desc:'Doce molinos y un castillo' },
  { n:'Toledo', estado:'futuro', desc:'El Alcaná. Cide Hamete.' },
  { n:'Esquivias', estado:'futuro', desc:'El hogar de Cervantes' },
  { n:'Madrid', estado:'futuro', desc:'Sus últimos años' },
  { n:'Alcalá de Henares', estado:'futuro', desc:'La verdad. El encuentro.' },
];
---
<Base
  title="Comienza el viaje — El Viaje de Dulcinea del Toboso"
  description="¿Y si Dulcinea hubiera decidido demostrar que es real? Una historia que comenzó hace más de cuatro siglos y que aún no ha terminado. Únete desde El Toboso.">

<Nav />

<!-- ===== 1. PANTALLA DE IMPACTO ===== -->
<header class="ci-hero">
  <img src="/img/comienza-hero.jpg" alt="Dulcinea de espaldas mirando el camino hacia El Toboso al atardecer" />
  <div class="ci-hero-texto">
    <span class="ci-lugar">El Toboso · Año 1616</span>
    <h1>¿Y si Dulcinea…<br /><em>hubiera decidido<br />demostrar<br />que es real?</em></h1>
    <p class="ci-subtitulo">Todos conocen la historia de Don Quijote.<br />Pero nadie ha acompañado nunca a Dulcinea.<br /><em>Hasta ahora.</em></p>
    <a class="ci-btn ci-btn-lacre" href="#video">Comenzar el viaje</a>
    <p class="ci-tagline">Una historia que comenzó hace más de cuatro siglos…<br /><em>y que aún no ha terminado.</em></p>
  </div>
</header>

<!-- ===== 2. VÍDEO ===== -->
<section class="ci-seccion ci-oscuro" id="video">
  <div class="ci-contenedor ci-centro">
    <span class="ci-eyebrow">Jornada I.1 · El Toboso · 1616</span>
    <h2>¿Dónde está Don Quijote?</h2>
    <p class="ci-intro">La primera jornada. El momento en que todo comenzó.</p>
    <div class="ci-video-marco">
      <iframe
        src="https://www.youtube.com/embed/WI5WYOb5tao"
        title="¿Dónde está Don Quijote? | El Viaje de Dulcinea — Jornada I.1"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen loading="lazy">
      </iframe>
    </div>
  </div>
</section>

<!-- ===== 3. FRASE ===== -->
<section class="ci-frase-universo">
  <div class="ci-contenedor ci-centro">
    <p class="ci-frase-grande">Todos conocen a Don Quijote.</p>
    <p class="ci-frase-grande ci-frase-lacre">Nadie ha acompañado nunca a Dulcinea.</p>
    <div class="ci-orn">❦</div>
    <p class="ci-frase-sub">El Viaje de Dulcinea no es una serie, ni un libro, ni una ruta.<br />Es un universo que está creciendo ahora mismo.</p>
  </div>
</section>

<!-- ===== 4. EL UNIVERSO ===== -->
<section class="ci-seccion ci-oscuro" id="universo">
  <div class="ci-contenedor">
    <div class="ci-universo-cab revela">
      <span class="ci-eyebrow" style="color:#C9A24B">El Universo de Dulcinea</span>
      <h2 style="color:#E8D194">Una historia que ya no cabe en un libro</h2>
      <p class="ci-intro" style="color:#CBB88E">El Viaje de Dulcinea nace como una historia cinematográfica, pero su camino no termina en la pantalla. Cada jornada conecta ficción, historia, patrimonio, ciudades, comercios y personas reales.</p>
      <p class="ci-frase-central">Una protagonista nacida en la ficción.<br /><em>Un viaje que está ocurriendo en el mundo real.</em></p>
    </div>

    <img class="ci-universo-img revela" src="/img/universo-dulcinea.jpg" alt="El Universo de Dulcinea — seis pilares conectados" style="transition-delay:.15s" />

    <div class="ci-pilares">
      {pilares.map((p, i) => (
        <article class="ci-pilar revela" style={`transition-delay:${0.08 * i}s`}>
          <div class="ci-pilar-img" style={`background-image:url('${p.img}')`}></div>
          <div class="ci-pilar-txt">
            <span class="ci-pilar-sub">{p.sub}</span>
            <h3>{p.titulo}</h3>
            <p>{p.txt}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="ci-expansion revela">
      {chips.map(c => <span class="ci-chip">{c}</span>)}
    </div>

    <div class="ci-universo-cta revela">
      <a class="ci-btn ci-btn-dorado" href="/participar#devoto">✦ Quiero formar parte</a>
      <a class="ci-btn ci-btn-borde-dorado" href="/">Explorar la web completa →</a>
    </div>
  </div>
</section>

<!-- ===== 5. LÍNEA TEMPORAL ===== -->
<section class="ci-seccion ci-linea-seccion" id="camino">
  <div class="ci-contenedor ci-centro">
    <span class="ci-eyebrow">El viaje acaba de comenzar</span>
    <h2>Todo lo que está por venir</h2>
    <p class="ci-intro">Esto va a durar años. Y tú puedes estar desde el principio.</p>
    <div class="ci-timeline revela">
      <div class="ci-tl-extremo">1616</div>
      <div class="ci-tl-linea">
        {villas.map(v => (
          <div class={`ci-tl-villa ${v.estado}`}>
            <div class="ci-tl-punto"></div>
            <div class="ci-tl-info">
              <strong>{v.n}</strong>
              <span>{v.desc}</span>
            </div>
          </div>
        ))}
        <div class="ci-tl-villa futuro">
          <div class="ci-tl-punto ci-tl-punto-oro"></div>
          <div class="ci-tl-info">
            <strong style="color:var(--oro)">¿Y después?</strong>
            <span>El universo seguirá creciendo</span>
          </div>
        </div>
      </div>
      <div class="ci-tl-extremo" style="color:var(--oro)">2026<br /><em style="font-size:.9rem;color:var(--tinta-suave)">y más allá</em></div>
    </div>
  </div>
</section>

<!-- ===== 6. CAPÍTULO I ===== -->
<section class="ci-seccion ci-oscuro" id="capitulo1">
  <div class="ci-contenedor ci-centro">
    <span class="ci-eyebrow">Capítulo I — El Toboso</span>
    <h2 style="color:#E8D194">Las jornadas de El Toboso</h2>
    <p class="ci-intro" style="color:#CBB88E">Dulcinea sigue en El Toboso. Estas son las jornadas de su primer capítulo:</p>
    <div class="ci-jornadas revela">
      <a class="ci-jornada ci-j-pub" href="https://www.youtube.com/watch?v=WI5WYOb5tao" target="_blank" rel="noopener">
        <span class="ci-j-num">I.1</span>
        <span class="ci-j-titulo">¿Dónde está Don Quijote?</span>
        <span class="ci-j-links">
          <span class="ci-j-yt">▶ YouTube</span>
          <a class="ci-j-ig" href="https://www.instagram.com/elviajededulcinea/reel/DavbF8Lp7g9/" target="_blank" rel="noopener" onclick="event.stopPropagation()">◈ Instagram</a>
        </span>
      </a>
      <a class="ci-jornada ci-j-pub" href="https://www.youtube.com/watch?v=TYM2j6gRpQI" target="_blank" rel="noopener">
        <span class="ci-j-num">I.2</span>
        <span class="ci-j-titulo">El Silencio del Caballero</span>
        <span class="ci-j-links">
          <span class="ci-j-yt">▶ YouTube</span>
          <a class="ci-j-ig" href="https://www.instagram.com/p/DbJBXDkpfC4/" target="_blank" rel="noopener" onclick="event.stopPropagation()">◈ Instagram</a>
        </span>
      </a>
      <div class="ci-jornada ci-j-pend">
        <span class="ci-j-num">I.3</span>
        <span class="ci-j-titulo">La voz que negó mi existencia</span>
        <span class="ci-j-links"><span class="ci-j-pronto">⏳ Próximamente</span></span>
      </div>
    </div>
    <a class="ci-btn ci-btn-borde-dorado" href="/#capitulos">Ver todos los capítulos →</a>
  </div>
</section>

<!-- ===== 7. HAZTE DEVOTO ===== -->
<section class="ci-seccion ci-devoto-seccion" id="devoto">
  <div class="ci-contenedor ci-centro">
    <span class="ci-eyebrow">Los Devotos de Dulcinea</span>
    <h2>Ayuda a que Dulcinea<br />siga existiendo</h2>
    <p class="ci-intro">Dulcinea existe porque alguien la mira. Cada comentario, cada visita, cada capítulo compartido hace que su historia llegue a otra persona. Y eso hace que el viaje continúe.</p>
    <p class="ci-intro"><em>Ya no estás ante un registro. Estás ante una misión.</em></p>
    <div class="ci-ventajas revela">
      <div class="ci-v">🪶<span>Recibe cada jornada antes que nadie</span></div>
      <div class="ci-v">⚜<span>Gana puntos e insignias por tu devoción</span></div>
      <div class="ci-v">📖<span>Contenido exclusivo que Cervantes nunca escribió</span></div>
      <div class="ci-v">🛡<span>Ventajas en los comercios Escuderos del camino</span></div>
    </div>
    <a class="ci-btn ci-btn-dorado ci-btn-grande" href="/participar#devoto">🪶 Únete. Sé devoto. Hazla real.</a>
    <p class="ci-nota">Gratis. Sin compromisos. Solo tu mirada.</p>
  </div>
</section>

<!-- ===== 8. REDES ===== -->
<section class="ci-seccion" id="redes">
  <div class="ci-contenedor ci-centro">
    <span class="ci-eyebrow">Sigue el viaje</span>
    <h2>Dulcinea te espera<br />en sus redes</h2>
    <div class="ci-redes">
      <a class="ci-red ci-red-yt" href="https://www.youtube.com/@elviajededulcinea" target="_blank" rel="noopener">
        <svg width="28" height="20" viewBox="0 0 28 20" fill="currentColor"><path d="M27.4 3.1A3.5 3.5 0 0 0 25 .7C22.8 0 14 0 14 0S5.2 0 3 .7A3.5 3.5 0 0 0 .6 3.1C0 5.3 0 10 0 10s0 4.7.6 6.9A3.5 3.5 0 0 0 3 19.3C5.2 20 14 20 14 20s8.8 0 11-.7a3.5 3.5 0 0 0 2.4-2.4C28 14.7 28 10 28 10s0-4.7-.6-6.9ZM11.2 14.3V5.7L18.5 10l-7.3 4.3Z"/></svg>
        @elviajededulcinea en YouTube
      </a>
      <a class="ci-red ci-red-ig" href="https://www.instagram.com/elviajededulcinea" target="_blank" rel="noopener">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        @elviajededulcinea en Instagram
      </a>
    </div>
    <div class="ci-orn">❦</div>
    <a class="ci-btn ci-btn-perg" href="/">Explorar la web completa →</a>
  </div>
</section>

<Colofon />

<style>
.ci-seccion{padding:5.5rem 1.3rem}
.ci-contenedor{max-width:1060px;margin:0 auto}
.ci-centro{text-align:center}
.ci-eyebrow{display:block;font-family:'IM Fell English SC',serif;font-size:.88rem;letter-spacing:.3em;color:var(--lacre);margin-bottom:.6rem}
.ci-seccion h2{font-family:'IM Fell English',serif;font-size:clamp(2rem,6vw,3.2rem);margin-bottom:.8rem}
.ci-intro{font-style:italic;color:var(--tinta-suave);font-size:1.06rem;max-width:620px;margin:.5rem auto 1.4rem}
.ci-orn{font-size:1.6rem;color:var(--oro);margin:1.4rem 0}
.ci-oscuro{background:#20150C;color:#CBB88E}
/* nav transparente en el hero */
.nav{transition:background .4s ease,border-color .4s ease}
.nav.nav-transparente{background:transparent;border-color:transparent}
.nav.nav-transparente .nav-links a,.nav.nav-transparente .nav-logo .titulo,.nav.nav-transparente .nav-logo .titulo b{color:rgba(239,223,174,.85)}
.nav.nav-transparente .nav-logo .emblema{border-color:rgba(239,223,174,.5);color:rgba(239,223,174,.7)}
.ci-oscuro h2{color:#E8D194}
.ci-oscuro .ci-eyebrow{color:#C9A24B}
.ci-hero{position:relative;min-height:100svh;display:flex;align-items:center;overflow:hidden;background:#1A0E06}
.ci-hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}
.ci-hero::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(26,14,6,.92) 0%,rgba(26,14,6,.65) 45%,rgba(26,14,6,.15) 75%,transparent 100%)}
.ci-hero-texto{position:relative;z-index:2;max-width:620px;padding:2rem 1.4rem 2rem clamp(1.4rem,6vw,5rem)}
.ci-lugar{display:block;font-family:'IM Fell English SC',serif;font-size:.88rem;letter-spacing:.35em;color:#C9A24B;margin-bottom:.9rem}
.ci-hero h1{font-family:'IM Fell English',serif;font-size:clamp(2.4rem,7vw,4.2rem);line-height:1.06;color:#F0E4C4;margin:0 0 1.2rem}
.ci-hero h1 em{font-style:italic;color:#E8D194}
.ci-subtitulo{font-family:'EB Garamond',serif;font-size:clamp(1rem,2.8vw,1.3rem);color:#CBB88E;margin-bottom:1.8rem;line-height:1.5}
.ci-subtitulo em{color:#C9A24B;font-style:italic}
.ci-tagline{font-family:'EB Garamond',serif;font-style:italic;font-size:.92rem;color:#8A7055;margin-top:1.4rem;line-height:1.6;letter-spacing:.02em}
.ci-btn{display:inline-block;font-family:'IM Fell English SC',serif;font-size:1rem;letter-spacing:.14em;padding:.95rem 2.1rem;text-decoration:none;transition:transform .2s,background .25s,opacity .2s;box-shadow:3px 3px 0 rgba(15,8,3,.4)}
.ci-btn:hover{transform:translateY(-3px)}
.ci-btn-lacre{background:var(--lacre);color:var(--pergamino-claro)}.ci-btn-lacre:hover{background:#611A13}
.ci-btn-dorado{background:linear-gradient(160deg,#B08A3E,#8A6423);color:#FBF3DC}.ci-btn-dorado:hover{opacity:.88}
.ci-btn-grande{font-size:1.15rem;padding:1.15rem 2.6rem}
.ci-btn-borde-dorado{background:transparent;color:#C9A24B;border:1.5px solid #C9A24B}.ci-btn-borde-dorado:hover{background:rgba(201,162,75,.1)}
.ci-btn-perg{background:var(--pergamino-claro);color:var(--tinta);border:1.5px solid var(--tinta)}.ci-btn-perg:hover{background:var(--pergamino-osc)}
.ci-video-marco{position:relative;width:100%;max-width:780px;margin:0 auto 1.8rem;padding-top:43.75%;border:2.5px solid rgba(176,138,62,.5);outline:1.5px solid rgba(176,138,62,.3);outline-offset:5px}
.ci-video-marco iframe{position:absolute;inset:0;width:100%;height:100%}
.ci-frase-universo{padding:5rem 1.3rem;background:var(--pergamino-osc);text-align:center}
.ci-frase-grande{font-family:'IM Fell English',serif;font-size:clamp(1.6rem,5vw,2.8rem);color:var(--tinta);line-height:1.2;margin:.2rem 0}
.ci-frase-lacre{color:var(--lacre)}
.ci-frase-sub{font-family:'EB Garamond',serif;font-style:italic;font-size:1.1rem;color:var(--tinta-suave);max-width:580px;margin:.6rem auto 0}
.ci-universo-cab{text-align:center;max-width:720px;margin:0 auto 2rem}
.ci-frase-central{font-family:'IM Fell English',serif;font-size:clamp(1.1rem,3vw,1.5rem);color:#E8D194;margin-top:1rem;line-height:1.4}
.ci-frase-central em{color:#C9A24B}
.ci-universo-img{width:100%;display:block;max-width:980px;margin:0 auto 3rem;border:1.5px solid rgba(176,138,62,.3)}
.ci-pilares{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.4rem;margin-bottom:2rem}
.ci-pilar{background:rgba(233,221,190,.06);border:1px solid rgba(176,138,62,.25);overflow:hidden;transition:transform .3s}
.ci-pilar:hover{transform:translateY(-5px)}
.ci-pilar-img{height:180px;background-size:cover;background-position:center}
.ci-pilar-txt{padding:1.2rem 1.3rem}
.ci-pilar-sub{font-family:'IM Fell English SC',serif;font-size:.78rem;letter-spacing:.18em;color:#C9A24B;display:block;margin-bottom:.25rem}
.ci-pilar-txt h3{font-family:'IM Fell English',serif;font-size:1.3rem;color:#E8D194;margin-bottom:.4rem}
.ci-pilar-txt p{font-size:.93rem;color:#CBB88E;line-height:1.55}
.ci-expansion{display:flex;flex-wrap:wrap;gap:.6rem;justify-content:center;margin:1.4rem 0 2.2rem}
.ci-chip{font-family:'IM Fell English SC',serif;font-size:.8rem;letter-spacing:.12em;color:#C9A24B;border:1px solid rgba(201,162,75,.4);padding:.35rem .85rem}
.ci-universo-cta{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}
.ci-linea-seccion{background:var(--pergamino)}
.ci-timeline{max-width:480px;margin:2rem auto 0;text-align:left}
.ci-tl-extremo{font-family:'IM Fell English',serif;font-size:1.8rem;color:var(--lacre);text-align:center;padding:.3rem 0}
.ci-tl-linea{border-left:2px solid var(--oro);margin-left:18px;padding:.3rem 0}
.ci-tl-villa{display:flex;align-items:flex-start;gap:1rem;padding:.5rem 1rem;position:relative}
.ci-tl-punto{width:16px;height:16px;border-radius:50%;flex:0 0 16px;margin-left:-9px;margin-top:.25rem;border:2px solid var(--tinta);background:var(--pergamino)}
.ci-tl-villa.actual .ci-tl-punto{background:var(--lacre);border-color:var(--lacre);width:20px;height:20px;margin-left:-11px;box-shadow:0 0 0 4px rgba(126,36,27,.22)}
.ci-tl-villa.futuro .ci-tl-punto{background:var(--pergamino-osc);border-color:var(--oro);border-style:dashed}
.ci-tl-punto-oro{background:var(--oro)!important;border-color:var(--oro)!important;width:20px!important;height:20px!important;margin-left:-11px!important}
.ci-tl-info{display:flex;flex-direction:column}
.ci-tl-info strong{font-family:'IM Fell English',serif;font-size:1.05rem;color:var(--tinta)}
.ci-tl-villa.actual .ci-tl-info strong{color:var(--lacre)}
.ci-tl-info span{font-size:.87rem;color:var(--tinta-suave);font-style:italic}
.ci-jornadas{display:flex;flex-direction:column;gap:.7rem;max-width:640px;margin:0 auto 1.8rem;text-align:left}
.ci-jornada{display:flex;align-items:center;gap:.9rem;padding:.8rem 1.1rem;border:1.5px solid rgba(176,138,62,.4);text-decoration:none;color:#E8D194;transition:background .2s,transform .2s}
.ci-j-pub{border-color:var(--lacre);cursor:pointer}.ci-j-pub:hover{background:rgba(126,36,27,.2);transform:translateX(5px)}
.ci-j-pend{opacity:.75;border-style:dashed;color:#8A7055}
.ci-j-num{font-family:'IM Fell English',serif;color:#C9A24B;font-size:1.05rem;flex:0 0 38px}
.ci-j-titulo{font-family:'IM Fell English',serif;font-size:1.05rem;flex:1}
.ci-j-links{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}
.ci-j-yt{font-family:'IM Fell English SC',serif;font-size:.78rem;background:var(--lacre);color:#FBF3DC;padding:.3rem .7rem}
.ci-j-ig{font-family:'IM Fell English SC',serif;font-size:.78rem;background:rgba(150,116,31,.7);color:#FBF3DC;padding:.3rem .7rem;text-decoration:none}
.ci-j-pronto{font-size:.82rem;font-style:italic;color:#8A7055}
.ci-devoto-seccion{background:linear-gradient(180deg,var(--pergamino-osc),var(--pergamino))}
.ci-ventajas{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.9rem;margin:1.6rem auto 2rem;max-width:820px;text-align:left}
.ci-v{display:flex;gap:.7rem;align-items:flex-start;background:rgba(43,33,21,.06);border:1px solid rgba(150,116,31,.35);padding:.9rem 1rem;font-size:.98rem;color:var(--tinta-suave)}
.ci-v>:first-child{font-size:1.4rem;flex:0 0 auto}
.ci-nota{font-style:italic;font-size:.88rem;color:var(--tinta-suave);margin-top:.9rem}
.ci-redes{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin:1.4rem 0}
.ci-red{display:inline-flex;align-items:center;gap:.7rem;font-family:'IM Fell English SC',serif;font-size:.95rem;letter-spacing:.08em;padding:.9rem 1.6rem;text-decoration:none;border:2px solid;transition:transform .2s}
.ci-red:hover{transform:translateY(-2px)}
.ci-red-yt{background:#7E241B;color:#F5E9D5;border-color:#5A1810}.ci-red-yt:hover{background:#611A13}
.ci-red-ig{background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045);color:#fff;border-color:transparent}
.revela{opacity:0;transform:translateY(22px);filter:blur(2px);transition:opacity .9s ease,transform .9s ease,filter .9s ease}
.revela.in{opacity:1;transform:none;filter:none}
@media (max-width:720px){
  .ci-hero-texto{padding:2rem 1.2rem}
  .ci-pilares{grid-template-columns:1fr}
  .ci-ventajas{grid-template-columns:1fr}
  .ci-redes,.ci-universo-cta{flex-direction:column;align-items:center}
}
@media (prefers-reduced-motion:reduce){.revela{opacity:1!important;transform:none!important;filter:none!important}}
</style>

<script is:inline>
/* nav transparente sobre el hero */
const nav = document.querySelector('.nav');
if (nav) {
  nav.classList.add('nav-transparente');
  window.addEventListener('scroll', () => {
    nav.classList.toggle('nav-transparente', window.scrollY < window.innerHeight * 0.6);
  }, { passive: true });
}
const obs = new IntersectionObserver((es) => es.forEach((e) => {
  if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
}), { threshold: 0.1 });
document.querySelectorAll('.revela').forEach((el) => obs.observe(el));
</script>

</Base>
