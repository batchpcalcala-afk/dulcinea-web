---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Colofon from '../components/Colofon.astro';
import datosEtapas from '../data/etapas.json';
import datosAliados from '../data/aliados.json';
import proyecto from '../data/proyecto.json';

const waLink = (texto: string) => `https://wa.me/${proyecto.whatsapp}?text=${encodeURIComponent(texto)}`;
const waDevoto = waLink('Hola, quiero hacerme Devoto de Dulcinea y saber cómo puedo participar');
const waEscudero = waLink('Hola, tengo un negocio y me interesa conocer cómo hacerme Escudero de Dulcinea');

const ROM = ['I','II','III','IV','V','VI','VII','VIII','IX','X','XI'];
const ESTADO_TXT = { publicado:'Capítulo ya escrito y publicado', actual:'Aquí se halla hoy Dulcinea', futuro:'Aún por escribir' };
const etapas = datosEtapas.etapas;
const aliados = datosAliados.aliados.filter((a:any) => !a.fundador);
const fundadores = datosAliados.aliados.filter((a:any) => a.fundador);
const ROMANOS = ['I','II','III','IV','V','VI','VII','VIII','IX','X','XI'];
const iActual = Math.max(0, etapas.findIndex((e:any) => e.estado === 'actual'));
const actual = etapas[iActual];
const capClass = (e:any) => e.estado==='publicado' ? 'publicado' : e.estado==='actual' ? 'actual-cap' : 'futuro-cap';

// Devotos y desbloqueo
const devotosActuales = datosEtapas._devotos_actuales || 0;
const siguienteUmbral = etapas.find((e:any) => e.devotosNecesarios > devotosActuales)?.devotosNecesarios || 0;
const progresoPct = siguienteUmbral > 0 ? Math.min(100, Math.round(devotosActuales / siguienteUmbral * 100)) : 100;
---
<Base
  title="El Viaje de Dulcinea del Toboso — El viaje que nunca termina"
  description="La auténtica Dulcinea de 1616 viaja de El Toboso a Alcalá de Henares en busca de Cervantes. Sigue su camino, descubre cada villa y a los escuderos que la ayudan.">

<Nav />
<div id="ano-badge"><span class="sc">Año de</span><b id="ano-num">1616</b></div>

<!-- ===== HÉROE ===== -->
<header class="heroe" id="historia">
  <canvas id="motas"></canvas>
  <div class="heroe-panel">
    <h1 class="p-item">El Viaje de<br />Dulcinea</h1>
    <div class="heroe-ornamento p-item" style="animation-delay:.4s">❦</div>
    <div class="heroe-sub p-item" style="animation-delay:.6s">Una historia viva entre Cervantes,<br />Alcalá de Henares y los Escuderos de Dulcinea</div>
    <p class="heroe-txt p-item" style="animation-delay:.9s">Dulcinea abandona El Toboso para buscar a Miguel de Cervantes y descubrir la verdad sobre su propia existencia. Cada villa del camino la acerca a Alcalá… y al año 2026.</p>
    <div class="heroe-botones p-item" style="animation-delay:1.2s">
      <a class="btn btn-lacre" href="#capitulos">🪶 Conoce la historia</a>
      <a class="btn btn-perg" href="#aliados">🛡 Ver Escuderos</a>
      <a class="btn btn-noche" href="/participar">✦ Quiero participar</a>
    </div>
  </div>
</header>

<!-- ===== TARJETAS DE ACCESO ===== -->
<div class="accesos">
  <div class="contenedor">
    <a class="acceso revela" href="#mapa">
      <div class="thumb" style="background-image:url('/img/mosaico-rutas.jpg')"></div>
      <div class="cuerpo"><h3><span class="ico">📍</span> La Ruta</h3><p>Sigue los pasos de Dulcinea desde El Toboso hasta Alcalá de Henares.</p><div class="enlace">Explorar ruta →</div></div>
    </a>
    <a class="acceso revela" href="#capitulos" style="transition-delay:.12s">
      <div class="thumb" style="background-image:url('/img/mosaico-libro.jpg')"></div>
      <div class="cuerpo"><h3><span class="ico">📖</span> Capítulos</h3><p>Descubre los capítulos de esta historia real y universal, escrita a lo largo del tiempo.</p><div class="enlace">Ver capítulos →</div></div>
    </a>
    <a class="acceso revela" href="#aliados" style="transition-delay:.24s">
      <div class="thumb" style="background-image:url('/img/mosaico-escuderos.jpg')"></div>
      <div class="cuerpo"><h3><span class="ico">🛡</span> Los Escuderos</h3><p>Conoce a quienes acompañan a Dulcinea en esta misión que trasciende siglos.</p><div class="enlace">Conocer escuderos →</div></div>
    </a>
  </div>
</div>

<!-- ===== BANDA DE CITA ===== -->
<div class="banda-cita">
  <svg class="molino-fondo izq" width="120" height="150" viewBox="0 0 120 150" fill="currentColor"><path d="M45,150 L75,150 L68,60 L52,60 Z"/><circle cx="60" cy="52" r="13"/><g stroke="currentColor" stroke-width="5" stroke-linecap="round"><line x1="60" y1="52" x2="105" y2="24"/><line x1="60" y1="52" x2="16" y2="20"/><line x1="60" y1="52" x2="95" y2="92"/><line x1="60" y1="52" x2="22" y2="86"/></g></svg>
  <span class="comillas">"</span>
  <blockquote>Y así, la que fue sueño en la pluma de un manco de Lepanto, se hace camino, se hace voz y se hace historia.</blockquote>
  <div class="firma">— Dulcinea —</div>
  <svg class="molino-fondo der" width="120" height="150" viewBox="0 0 120 150" fill="currentColor"><path d="M45,150 L75,150 L68,60 L52,60 Z"/><circle cx="60" cy="52" r="13"/><g stroke="currentColor" stroke-width="5" stroke-linecap="round"><line x1="60" y1="52" x2="105" y2="24"/><line x1="60" y1="52" x2="16" y2="20"/><line x1="60" y1="52" x2="95" y2="92"/><line x1="60" y1="52" x2="22" y2="86"/></g></svg>
</div>

<!-- ===== MAPA BLOQUEADO ===== -->
<section class="mapa-bloq-seccion" id="mapa">
  <div class="contenedor">
    <div class="cabecera-seccion revela">
      <span class="sc">La Ruta</span>
      <h2>El camino de Dulcinea</h2>
      <p>Solo El Toboso está disponible. El resto del camino se irá revelando a medida que crezca la comunidad de Devotos.</p>
    </div>
    <div class="mapa-bloq-marco revela" style="transition-delay:.15s">
      <img
        src="/img/mapa-bloqueado.jpg"
        alt="Mapa del viaje de Dulcinea con destinos bloqueados por candados dorados. Solo El Toboso aparece disponible."
        class="mapa-bloq-img"
        usemap="#mapa-toboso"
      />
      <!-- zona clicable sobre El Toboso (esquina inferior derecha ~83-100%, 68-100%) -->
      <a
        class="mapa-toboso-zona"
        href="#capitulos"
        aria-label="El Toboso — Disponible. Ver Capítulo I"
        title="El Toboso · Disponible — Ver Capítulo I"
      ></a>
    </div>
    <p class="mapa-bloq-nota revela">❧ Hazte Devoto para saber adónde va Dulcinea — <a href="/participar#devoto">Unirse al viaje →</a> · <a href={waDevoto} target="_blank" rel="noopener">Preguntar por WhatsApp</a></p>
  </div>
</section>

<!-- ===== CAPÍTULOS ===== -->
<section id="capitulos">
  <div class="contenedor">
    <div class="cabecera-seccion revela">
      <span class="sc">Segunda parte</span>
      <h2>Capítulos deste viaje</h2>
      <p>Dulcinea recorre el camino. Los Devotos revelan los próximos destinos.</p>
    </div>

    <!-- contador de devotos -->
    <div class="devotos-contador revela">
      <div class="dc-texto">
        <span class="dc-num">{devotosActuales}</span>
        <span class="dc-label">Devotos de Dulcinea</span>
      </div>
      {siguienteUmbral > 0 && (
        <div class="dc-progreso-zona">
          <div class="dc-meta">
            <span>Próximo destino se revela a <b>{siguienteUmbral}</b> Devotos</span>
            <span class="dc-pct">{progresoPct}%</span>
          </div>
          <div class="dc-barra"><div class="dc-barra-inner" style={`width:${progresoPct}%`}></div></div>
          <p class="dc-cta-texto">¿Quieres saber adónde va Dulcinea? <a href="/participar#devoto">Hazte Devoto →</a> · <a href={waDevoto} target="_blank" rel="noopener">WhatsApp</a></p>
        </div>
      )}
    </div>

    <!-- jornadas del Capítulo I — siempre visibles en la portada -->
    <div class="cap1-jornadas revela">
      <div class="cap1-cab">
        <span class="sc" style="color:var(--lacre);letter-spacing:.25em;font-size:.85rem">Capítulo I — El Toboso</span>
        <h3>Las jornadas de El Toboso</h3>
        <p class="cap1-sub">Dulcinea sigue en El Toboso. Estas son las jornadas de su primer capítulo:</p>
      </div>
      <div class="cap1-lista">
        {etapas[0].jornadas.map((j:any, ji:number) => (
          <div class={`cap1-jornada ${j.url ? 'cap1-pub' : 'cap1-pend'}`}>
            <span class="cap1-num">I.{ji+1}</span>
            <span class="cap1-titulo">{j.titulo}</span>
            <span class="cap1-enlaces">
              {j.url
                ? <>
                    <a class="cap1-btn cap1-yt" href={j.url} target="_blank" rel="noopener">▶ YouTube</a>
                    {j.instagram && <a class="cap1-btn cap1-ig" href={j.instagram} target="_blank" rel="noopener">◈ Instagram</a>}
                  </>
                : <span class="cap1-pronto">⏳ Próximamente</span>
              }
            </span>
          </div>
        ))}
      </div>
    </div>

    <div class="capitulos-grid">
      {etapas.map((e:any, i:number) => {
        const desbloqueado = devotosActuales >= e.devotosNecesarios;
        const esI = i === 0;
        return desbloqueado ? (
          <article class={`cap revela ${capClass(e)}`} style={`transition-delay:${(i%4)*.12}s`} data-etapa={i}>
            <span class="ano">{e.ano}</span>
            <span class="num">Capítulo {ROM[i]}</span>
            <h3>{e.muni}</h3>
            <span class="estado">{ESTADO_TXT[e.estado as keyof typeof ESTADO_TXT]}</span>
            {e.txt && <p>{e.txt}</p>}
            {e.pat && <div class="patrimonio">{e.pat}</div>}
          </article>
        ) : (
          <article class="cap cap-bloqueado revela" style={`transition-delay:${(i%4)*.12}s`}>
            <span class="ano ano-bloqueado">{e.ano}</span>
            <div class="candado">⚜</div>
            <span class="num">Capítulo {ROM[i]}</span>
            <h3 class="destino-oculto">Destino no revelado</h3>
            <div class="bloqueo-info">
              <span class="bloqueo-umbral">Se revela a {e.devotosNecesarios} Devotos</span>
              <div class="bloqueo-barra">
                <div class="bloqueo-barra-inner" style={`width:${Math.min(100,Math.round(devotosActuales/e.devotosNecesarios*100))}%`}></div>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <div class="fleuron revela">❦ ❦ ❦</div>
  </div>
</section>
<!-- ===== JORNADAS DEL CAPÍTULO ACTUAL ===== -->
{/* Mostrar jornadas del capítulo actual (El Toboso) */}
{actual && actual.jornadas && actual.jornadas.length > 0 && (
<section class="jornadas-cap" id="jornadas">
  <div class="contenedor">
    <div class="jornadas-cab revela">
      <span class="sc">Capítulo I · El Toboso</span>
      <div class="jornadas-orn">❦</div>
      <h2>Las Jornadas del Toboso</h2>
      <p class="jornadas-intro">Cada jornada es un paso del viaje. Síguelas por orden o descúbrelas a tu ritmo.</p>
    </div>
    <div class="jornadas-lista">
      {actual.jornadas.map((j: any, idx: number) => (
        <article class="jornada-fila revela" style={`transition-delay:${idx * 0.14}s`}>
          <a class="jornada-thumb" href={j.url} target="_blank" rel="noopener" aria-label={`Ver ${j.titulo} en YouTube`}>
            <img
              src={`https://img.youtube.com/vi/${j.youtubeId}/maxresdefault.jpg`}
              alt={`Miniatura de la jornada: ${j.titulo}`}
              loading="lazy"
              onerror="this.src='https://img.youtube.com/vi/' + this.src.split('/vi/')[1].split('/')[0] + '/hqdefault.jpg'"
            />
            <div class="jornada-play-ico">
              <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="22" cy="22" r="21" fill="rgba(30,20,10,0.68)" stroke="#C8922A" stroke-width="1.5"/>
                <polygon points="18,14 32,22 18,30" fill="#FBF3DC"/>
              </svg>
            </div>
            <div class="jornada-thumb-sombra"></div>
          </a>
          <div class="jornada-info">
            <div class="jornada-num-wrap">
              <span class="jornada-num">Jornada {['I','II','III','IV','V','VI','VII','VIII','IX','X'][idx]}</span>
            </div>
            <h3 class="jornada-titulo">{j.titulo}</h3>
            <div class="jornada-btns">
              <a class="jornada-btn jornada-btn-yt" href={j.url} target="_blank" rel="noopener">
                <svg width="18" height="14" viewBox="0 0 18 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M17.6 2.18A2.26 2.26 0 0 0 16.01.57C14.62.18 9 .18 9 .18S3.38.18 1.99.57A2.26 2.26 0 0 0 .4 2.18C0 3.6 0 6.5 0 6.5s0 2.9.4 4.32a2.26 2.26 0 0 0 1.59 1.61C3.38 12.82 9 12.82 9 12.82s5.62 0 7.01-.39a2.26 2.26 0 0 0 1.59-1.61C18 9.4 18 6.5 18 6.5s0-2.9-.4-4.32ZM7.14 9.21V3.79l4.68 2.71-4.68 2.71Z" fill="#FBF3DC"/>
                </svg>
                Ver en YouTube
              </a>
              {j.instagram && (
                <a class="jornada-btn jornada-btn-ig" href={j.instagram} target="_blank" rel="noopener">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect x="1" y="1" width="14" height="14" rx="4" stroke="#F5EEFF" stroke-width="1.5" fill="none"/>
                    <circle cx="8" cy="8" r="3.2" stroke="#F5EEFF" stroke-width="1.4" fill="none"/>
                    <circle cx="11.8" cy="4.2" r="0.9" fill="#F5EEFF"/>
                  </svg>
                  Ver en Instagram
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="jornadas-pie revela">
      <span class="sc">Más jornadas próximamente</span>
      <div class="jornadas-orn">❧</div>
      <p>Sigue a Dulcinea en <a href="https://www.youtube.com/@elviajededulcinea" target="_blank" rel="noopener">YouTube</a> e <a href="https://www.instagram.com/elviajededulcinea" target="_blank" rel="noopener">Instagram</a> para no perderte ninguna jornada.</p>
    </div>
  </div>
</section>
)}
<!-- ===== ESCUDEROS ===== -->
<section id="aliados">
  <div class="contenedor">
    <div class="cabecera-seccion revela">
      <span class="sc">Tercera parte</span>
      <h2>Los escuderos de Dulcinea</h2>
      <p>No son mecenas ni pregoneros: son parte de la historia. Cada comercio socorre a Dulcinea en su camino… y guarda para siempre la prueba de su paso.</p>
    </div>

    {fundadores.map((f:any) => (
      <article class="fundador revela">
        <span class="flor a">⚜</span><span class="flor b">⚜</span><span class="flor c">⚜</span><span class="flor d">⚜</span>
        <div class="fundador-cab">
          <img class="mono" src="/img/fundador-monograma.jpg" alt="Monograma de Dulcinea" />
          <div class="fundador-placa-zona">
            <div class="fundador-placa"><span class="txt">Escudero Fundador</span><img src="/img/fundador-sello.jpg" alt="Sello de lacre" /></div>
            <div class="fundador-desde">Desde {f.desde}</div>
          </div>
        </div>
        <h3 class="fundador-nombre">{f.nombre}</h3>
        <div class="fundador-tagline">{f.tagline}</div>
        <div class="fundador-orn">✦</div>
        <p class="fundador-desc">{f.descripcion}</p>
        {f.foto && (
          <a class="fundador-foto" href={f.video?.youtube || '#'} target="_blank" rel="noopener" aria-label={`Dulcinea llega a ${f.nombre}`}>
            <img src={f.foto} alt={`Dulcinea llegando a la puerta de ${f.nombre} en ${f.paradaVilla}`} />
          </a>
        )}
        
        <div class="fundador-pie">
          <div class="fundador-parada">{ROMANOS[f.parada-1]}</div>
          <div class="fundador-lugar">
            <h4>{f.paradaVilla}</h4>
            <div class="sub">Parada {ROMANOS[f.parada-1]} del itinerario de Dulcinea</div>
            <div class="aqui">Dulcinea estuvo aquí</div>
          </div>
        </div>
      </article>
    ))}

    <div class="aliados-grid">
      {aliados.map((a:any, i:number) => (
        <article class="aliado revela" style={`transition-delay:${(i%4)*.12}s`}>
          <div class="sello">Dulcinea<br />estuvo<br />aquí</div>
          <h3>{a.nombre}</h3>
          <span class="tipo">{a.tipo}</span>
          <p>«{a.txt}»</p>
          <div class="muni">❧ {a.muni} · Ved su capítulo</div>
        </article>
      ))}
    </div>

    <div class="pregon revela" id="contacto">
      <h3>¿Queréis que Dulcinea llame a vuestra puerta?</h3>
      <p>Vuestro negocio puede formar parte del viaje: un vídeo protagonizado por Dulcinea, vuestro lugar en la Carta del Camino, materiales para las redes y un pergamino exclusivo que rece «Dulcinea estuvo aquí».</p>
      <p class="pregon-prueba">Como <strong>fisiohenares</strong>, nuestro primer Escudero: su vídeo ya supera las <strong>2.000 visualizaciones</strong>.</p>
      <div class="pregon-botones">
        <a class="boton-lacre" href="/participar#escudero">Hacerse escudero</a>
        <a class="boton-perg" href={waEscudero} target="_blank" rel="noopener">🛡 Escribir por WhatsApp</a>
      </div>
    </div>
  </div>
</section>

<!-- ===== ESTÁ POR VENIR ===== -->
<section id="proximas">
  <div class="contenedor">
    <div class="cabecera-seccion revela">
      <span class="sc">Última parte</span>
      <h2>De lo que está por venir</h2>
    </div>
    <div class="calendario revela">
      <div class="evento">
        <span class="fecha">Capítulo que se escribe ahora</span>
        <h3>I — El Toboso</h3>
        <p>Las jornadas de El Toboso se están escribiendo. Cada nueva jornada, un paso más hacia la verdad.</p>
      </div>
      <div class="evento">
        <span class="fecha">Lo que viene</span>
        <h3>El próximo destino, oculto</h3>
        <p>Solo los Devotos sabrán adónde va Dulcinea. Hazte Devoto y sé el primero en conocerlo.</p>
      </div>
      <div class="evento">
        <span class="fecha">El destino final</span>
        <h3>Alcalá de Henares · 2026</h3>
        <p>La ciudad de Cervantes. El encuentro. La verdad. Pero el camino hasta allí está por revelar.</p>
      </div>
    </div>
  </div>
</section>

<Colofon />

<script is:inline type="application/json" id="datos-etapas" set:html={JSON.stringify({ etapas, iActual, devotosActuales })}></script>
<script src="../scripts/portal.js"></script>

</Base>
